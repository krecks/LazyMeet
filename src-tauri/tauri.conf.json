{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LazyMeet",
  "version": "0.1.4",
  "identifier": "ai.lazymeet.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LazyMeet",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local, private meeting transcription",
    "longDescription": "Drag and drop a recording to get a per-speaker transcript and summary, fully local and private.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
