{
  "name": "lazymeet",
  "private": true,
  "description": "Frontend tooling: TypeScript type checking and the Vite bundle.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:smoke": "npm run typecheck && vite build --mode smoke",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "5.9.3",
    "vite": "^7.3.7"
  }
}
