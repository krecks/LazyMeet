{
  // The frontend is TypeScript ES modules under frontend/ts/, bundled by Vite
  // (vite.config.ts) into frontend/dist, which is not committed. tsc only
  // type-checks (noEmit); `npm run build` runs this before bundling, so a type
  // error fails the build before Vite emits anything.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["frontend/ts/**/*.ts", "frontend/smoke/**/*.ts"]
}
