{
  // The frontend ships as classic scripts: no imports/exports, one shared page
  // scope, loaded by frontend/index.html. tsc compiles frontend/ts/*.ts to
  // frontend/js/*.js, which is committed so `cargo tauri build` and the smoke
  // test run without node; CI re-runs the build and fails on drift.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "none",
    "rootDir": "frontend/ts",
    "outDir": "frontend/js",
    "noEmitOnError": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["frontend/ts/**/*.ts"]
}
