{
  // Type checking only: the frontend ships as classic scripts loaded by
  // frontend/index.html, so tsc never emits. `checkJs` checks the existing
  // .js files as-is — no bundler, no imports, no build step in the app path.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["frontend/js/**/*.js", "frontend/types/**/*.d.ts"]
}
