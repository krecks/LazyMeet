{
  // The Vite config runs on node (it reads import.meta.url), so it is checked
  // separately: the app tsconfig sets "types": [] to keep Node globals out of
  // the frontend.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["vite.config.ts"]
}
